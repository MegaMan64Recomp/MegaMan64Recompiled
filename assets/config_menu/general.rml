<template name="config-menu__general">
    <head>
    </head>
    <body>
        <form class="config__form" id="conf-general__form">
            <div class="config__hz-wrapper" id="conf-general__hz-wrapper">
                <!-- Options -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" id="conf-general__wrapper">
                    <!-- rumble strength -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">Rumble Strength</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{rumble_strength}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                id="rumble_strength_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp;"
                                data-value="rumble_strength"
                            />
                        </div>
                    </div>
                    
                    <!-- joystick deadzone -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(4)">
                        <label class="config-option__title">Joystick Deadzone</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{joystick_deadzone}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(4)"
                                id="joystick_deadzone_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-down: #bg_input_enabled"
                                data-value="joystick_deadzone"
                            />
                        </div>
                    </div>

                    <!-- background input -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(5)" id="conf-general__Background-Input">
                        <label class="config-option__title">Background Input</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="On"
                                id="bg_input_enabled"
                                style="nav-up: #joystick_deadzone_input; nav-down: #film_grain_mode_on"
                            />
                            <label class="config-option__tab-label" for="bg_input_enabled">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(5)"
                                name="background_input_mode"
                                data-checked="background_input_mode"
                                value="Off"
                                id="bg_input_disabled"
                                style="nav-up: #joystick_deadzone_input; nav-down: #film_grain_mode_off"
                            />
                            <label class="config-option__tab-label" for="bg_input_disabled">Off</label>
                        </div>
                    </div>

                    <!-- Invert Y Axis -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(7)">
                        <label class="config-option__title">Invert Y Axis</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="invert_y_axis_mode"
                                data-checked="invert_y_axis_mode"
                                value="On"
                                id="invert_y_axis_mode_on"
                                style="nav-up: #film_grain_mode_on;"
                            />
                            <label class="config-option__tab-label" for="invert_y_axis_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(7)"
                                name="invert_y_axis_mode"
                                data-checked="invert_y_axis_mode"
                                value="Off"
                                id="invert_y_axis_mode_off"
                                style="nav-up: #film_grain_mode_off;"
                            />
                            <label class="config-option__tab-label" for="invert_y_axis_mode_off">Off</label>
                        </div>
                    </div>

                    <!-- mouse camera -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(10)">
                        <label class="config-option__title">Mouse Camera</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="mouse_camera_mode"
                                data-checked="mouse_camera_mode"
                                value="Off"
                                id="mouse_camera_mode_off"
                                style="nav-up: #invert_y_axis_mode_on; nav-down: #mouse_sensitivity_input"
                            />
                            <label class="config-option__tab-label" for="mouse_camera_mode_off">Off</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="mouse_camera_mode"
                                data-checked="mouse_camera_mode"
                                value="ThirdPerson"
                                id="mouse_camera_mode_third"
                                style="nav-up: #invert_y_axis_mode_on; nav-down: #mouse_sensitivity_input"
                            />
                            <label class="config-option__tab-label" for="mouse_camera_mode_third">Third Person</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(10)"
                                name="mouse_camera_mode"
                                data-checked="mouse_camera_mode"
                                value="FirstPerson"
                                id="mouse_camera_mode_first"
                                style="nav-up: #invert_y_axis_mode_off; nav-down: #mouse_sensitivity_input"
                            />
                            <label class="config-option__tab-label" for="mouse_camera_mode_first">First Person</label>
                        </div>
                    </div>

                    <!-- mouse sensitivity -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">Mouse Sensitivity</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{mouse_sensitivity}}%</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(3)"
                                id="mouse_sensitivity_input"
                                type="range"
                                min="0"
                                max="100"
                                style="flex: 1; margin: 0dp; nav-up: #mouse_camera_mode_off; nav-down: #first_person_strafe_mode_on"
                                data-value="mouse_sensitivity"
                            />
                        </div>
                    </div>

                    <!-- field of view -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(12)">
                        <label class="config-option__title">Field of View</label>
                        <div class="config-option__range-wrapper config-option__list">
                            <label class="config-option__range-label">{{mouse_camera_fov}}°</label>
                            <input
                                class="nav-vert"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(12)"
                                id="mouse_camera_fov_input"
                                type="range"
                                min="45"
                                max="110"
                                style="flex: 1; margin: 0dp;"
                                data-value="mouse_camera_fov"
                            />
                        </div>
                    </div>

                    <!-- first person strafe -->
                    <div class="config-option" data-event-mouseover="set_cur_config_index(11)">
                        <label class="config-option__title">First Person Strafe</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="first_person_strafe_mode"
                                data-checked="first_person_strafe_mode"
                                value="On"
                                id="first_person_strafe_mode_on"
                                style="nav-up: #mouse_sensitivity_input"
                            />
                            <label class="config-option__tab-label" for="first_person_strafe_mode_on">On</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(11)"
                                name="first_person_strafe_mode"
                                data-checked="first_person_strafe_mode"
                                value="Off"
                                id="first_person_strafe_mode_off"
                                style="nav-up: #mouse_sensitivity_input"
                            />
                            <label class="config-option__tab-label" for="first_person_strafe_mode_off">Off</label>
                        </div>
                    </div>

                </div>

                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">
                        Controls how targeting enemies and objects works. <b>Switch</b> will start or stop targeting each time the target button is pressed. <b>Hold</b> will start when the target button is pressed and stop when the button is released. 
                    </p>
                    <p data-if="cur_config_index == 1">
                        Controls the strength of rumble when using a controller that supports it. <b>Setting this to zero will disable rumble.</b>
                    </p>
                    <p data-if="cur_config_index == 2">
                        Controls the sensitivity of gyro aiming when using items in first person for controllers that support it. <b>Setting this to zero will disable gyro.</b>
                        <br />
                        <br />
                        <b>Note: To recalibrate controller gyro, set the controller down on a still, flat surface for 5 seconds.</b>
                    </p>
                    <p data-if="cur_config_index == 3">
                        Controls how fast the <b>Mouse Camera</b> turns and tilts. <b>Setting this to zero will stop the mouse from moving the camera.</b>
                    </p>
                    <p data-if="cur_config_index == 4">
                        Applies a deadzone to joystick inputs.
                    </p>
                    <p data-if="cur_config_index == 5">
                        Allows the game to read controller input when out of focus.
                        <br/>
                        <b>This setting does not affect keyboard input.</b>
                    </p>
                    <p data-if="cur_config_index == 6">
                        Adds a visual effect that simulates the random grain you see in old film or high-ISO camera footage.
                        <br/>
                    </p>
                    <p data-if="cur_config_index == 7">
                        Inverts the Y axis aiming controls. <b>On</b> is the default and matches the original game.
                    </p>
                    <p data-if="cur_config_index == 8">
                        Alignment for Radio Communications Box.
                        <br/>
                    </p>
                    <p data-if="cur_config_index == 9">
                        Inverts the camera controls for the analog camera if it's enabled. <b>None</b> is the default.
                    </p>
                    <p data-if="cur_config_index == 12">
                        Horizontal field of view in <b>First Person</b>. Third person keeps the game's own, about <b>49°</b>.
                    </p>
                    <p data-if="cur_config_index == 11">
                        In <b>First Person</b> with the <b>Mouse Camera</b>, moving left or right strafes sideways like a classic shooter instead of turning, since the mouse already turns Mega Man. <b>Off</b> keeps the original turning controls.
                    </p>
                    <p data-if="cur_config_index == 10">
                        Play with mouse look. <b>First Person</b> puts the camera at Mega Man's eyes: the mouse turns him and tilts the view, shots follow the crosshair and a light aim assist helps near enemies. <b>Third Person</b> orbits the camera freely around him and he walks where the camera points; hold the <b>right mouse button</b> to aim over his shoulder and use the <b>mouse wheel</b> to zoom.
                        <br />
                        <br />
                        Click the <b>middle mouse button</b> in game to swap between first and third person. If no mouse buttons are bound in the keyboard controls, <b>left click</b> fires the buster and <b>right click</b> the special weapon (in third person, a quick click; holding it aims).
                        <br />
                        <br />
                        <b>Note: The cursor is captured while playing. Open the menu to release it.</b>
                    </p>
                </div>
            </div>
        </form>
    </body>
</template>
